rpc = [
    "https://eth.llamarpc.com",
    "https://rpc.ankr.com/eth",
    "https://cloudflare-eth.com",
]
start_block = 19000000
end_block = 19000500

[[chains]]
caip2 = "eip155:8453"
rpc = [
    "https://mainnet.base.org",
    "https://base.llamarpc.com",
]
start_block = 12000000
end_block = 12000500

